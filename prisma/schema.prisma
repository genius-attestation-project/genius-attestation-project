  isActive     Boolean  @default(true) @map("is_active")
  ownerAdminId String   @map("owner_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([processType, ownerAdminId])
  @@index([ownerAdminId])
  @@map("sla_configurations")
}

model HolidayCalendar {
  id           String   @id @default(cuid())
  holidayDate  DateTime @map("holiday_date") @db.Date
  title        String
  isWeekend    Boolean  @default(false) @map("is_weekend")
  isActive     Boolean  @default(true) @map("is_active")
  ownerAdminId String   @map("owner_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([holidayDate, ownerAdminId])
  @@index([ownerAdminId])
  @@map("holiday_calendar")
}

model CommunicationTemplate {
  id           String   @id @default(cuid())
  type         String   // Email, SMS, WhatsApp
  name         String
  subject      String?
  body         String   @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  ownerAdminId String   @map("owner_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([type, name, ownerAdminId])
  @@index([type])
  @@index([ownerAdminId])
  @@map("communication_templates")
}

model GeneralSetting {
  id           String   @id @default(cuid())
  settingKey   String   @map("setting_key")
  settingValue String   @db.Text @map("setting_value")
  description  String?
  ownerAdminId String   @map("owner_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([settingKey, ownerAdminId])
  @@index([ownerAdminId])
  @@map("general_settings")
}

model AssignedAgency {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  ownerAdminId String    @map("owner_admin_id")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  assignedPackages AssignedAgencyPackage[]

  @@index([ownerAdminId])
  @@index([isActive])
  @@map("assigned_agencies")
}

model AssignedAgencyPackage {
  id               String         @id @default(cuid())
  assignedAgencyId String         @map("assigned_agency_id")
  assignedAgency   AssignedAgency @relation(fields: [assignedAgencyId], references: [id], onDelete: Cascade)
  processTypeId    String         @map("process_type_id")
  processType      ProcessType    @relation(fields: [processTypeId], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([assignedAgencyId, processTypeId])
  @@index([assignedAgencyId])
  @@index([processTypeId])
  @@map("assigned_agency_packages")
}
